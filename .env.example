# QR Inventory System production-readiness environment template
# Copy this file to a host-specific environment configuration and replace values.

# Administrator password for Web admin features. Always change in production.
QR_INVENTORY_ADMIN_PASSWORD=change_me

# Runtime environment label. Use development, staging, or production.
QR_INVENTORY_ENV=development

# SQLite database file path. Keep this on persistent storage and include it in backups.
QR_INVENTORY_DB_PATH=data/inventory.db
